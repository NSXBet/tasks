---
import { getCollection, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

const entries = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    ...(await render(entry)),
  })),
);

const outline = rendered.map(({ entry, headings }) => ({
  id: entry.id,
  title: entry.data.title,
  headings: headings.filter((h) => h.depth >= 2 && h.depth <= 3),
}));
---

<DocsLayout outline={outline}>
  {
    rendered.map(({ entry, Content }) => (
      <section class="doc" id={entry.id} aria-label={entry.data.title}>
        <Content />
      </section>
    ))
  }
</DocsLayout>
