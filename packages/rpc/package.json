{
  "name": "@tasks/rpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run --filter @tasks/surface build && tsc -p tsconfig.json",
    "check": "bun run --filter @tasks/surface build && tsc --noEmit -p tsconfig.json",
    "test": "bun run build && cd ../.. && bun test packages/rpc/test"
  },
  "dependencies": {
    "@tasks/surface": "workspace:*",
    "typebox": "^1.3.18"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
